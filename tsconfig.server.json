{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "vite.config.ts",
    "src/virtual-modules.d.ts",
    "src/motion-arsenal/community/**/*.ts"
  ]
}
